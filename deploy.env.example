# hostm deployment settings for deploy.sh
# ----------------------------------------
# Copy this file to  deploy.env  and fill in your details:
#     cp deploy.env.example deploy.env
# deploy.env is gitignored, so your password is NEVER committed or pushed.

# Protocol:
#   ftps = FTP over TLS  (always available on hostm — use this unless you
#          have specifically enabled SSH)
#   sftp = FTP over SSH  (only if SSH access is enabled on your account)
DEPLOY_PROTOCOL=ftps

# Server hostname. Your domain usually works; cPanel → FTP Accounts →
# "Configure FTP Client" shows the exact value.
DEPLOY_HOST=forrestersavell.com

# Login. Easiest path: in cPanel → FTP Accounts, create an account whose
# "Directory" is set to  public_html , then use its username + password here.
DEPLOY_USER=deploy@forrestersavell.com
DEPLOY_PASS=change-me

# Where the web root lives, relative to where your login lands:
#   - FTP account rooted AT public_html  ->  .
#   - main cPanel account (lands in home) ->  public_html
DEPLOY_REMOTE_DIR=public_html

# Only set this if your host uses a non-standard port (usually not needed):
# DEPLOY_PORT=21

# Local web root inside this repo — leave as-is.
DEPLOY_LOCAL_DIR=site
