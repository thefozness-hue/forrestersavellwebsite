# Static site — no PHP, no database.

ErrorDocument 404 /404.html

# The old per-release WordPress pages were byte-identical copies of the
# homepage; send them (and the old archive feeds/endpoints) home.
RedirectMatch 301 ^/project/.+ /#artists
RedirectMatch 301 ^/(feed|comments/feed)/?$ /
RedirectMatch 301 ^/portfolio-item/.* /#artists

# WordPress is gone — return 410 for its endpoints so bots stop probing.
RedirectMatch 410 ^/wp-(admin|login\.php|json|cron\.php)
RedirectMatch 410 ^/xmlrpc\.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
