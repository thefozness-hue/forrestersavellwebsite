# Static site — no PHP, no database.

# Force HTTPS. Proxy-aware: cPanel may terminate TLS upstream, so only redirect
# when the request is genuinely plain HTTP (both checks must indicate HTTP) —
# that way an upstream-HTTPS request is never redirected and can't loop.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

ErrorDocument 404 /404.html

# The old per-release WordPress pages were byte-identical copies of the
# homepage; send them (and the old archive feeds/endpoints) home.
RedirectMatch 301 ^/project/.+ /#artists
RedirectMatch 301 ^/(feed|comments/feed)/?$ /
RedirectMatch 301 ^/portfolio-item/.* /#artists

# WordPress is gone — return 410 for its endpoints so bots stop probing.
RedirectMatch 410 ^/wp-(admin|login\.php|json|cron\.php)
RedirectMatch 410 ^/xmlrpc\.php

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HSTS on the apex host only — deliberately no includeSubDomains/preload, so
  # the preview subdomain isn't forced to HTTPS. Only honored over HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"

  # Content-Security-Policy. Only four external origins are real network loads:
  #   fonts.googleapis.com  - the Poppins stylesheet   (style-src)
  #   fonts.gstatic.com     - the font files           (font-src)
  #   www.googletagmanager.com - gtag.js analytics     (script/img/connect-src)
  #   open.spotify.com      - the playlist embed       (frame-src)
  # Everything else (facebook/twitter/instagram/swiftsites/nailthemix) is only
  # <a href> links, and w3.org/schema.org are XML namespaces + JSON-LD strings —
  # none of those are fetched, so none need allowlisting.
  #
  # 'unsafe-inline' is required for scripts and styles: the pages carry inline
  # <style> blocks, inline style="" attributes and inline scripts (the gtag
  # snippet and the contact-form token script). Nonces would need server-side
  # rendering, and hashes would silently break the form on every content edit.
  # So this policy is not a full XSS defence — its value is blocking injected
  # off-site script/frame/form targets, plus base-uri and object-src lockdown.
  #
  # Verified in a real browser as Report-Only first: zero violations from the
  # site's own resources (fonts, GTM/analytics, Spotify embed and the contact
  # form's token fetch all passed), with a deliberate off-origin probe proving
  # violations were being detected. Then switched to enforcing.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; frame-src https://open.spotify.com; upgrade-insecure-requests"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
